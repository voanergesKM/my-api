# HF receipt image model; append :provider if you want to pin a provider.
HF_RECEIPT_MODEL=Qwen/Qwen3-VL-32B-Instruct
# Set false only if the selected provider rejects response_format/json_schema.
# Server-side validation is always enabled.
HF_RECEIPT_STRUCTURED_OUTPUT=true
HF_BASE_URL=https://router.huggingface.co/v1
HF_API_TOKEN=

# Separate receipt endpoint: POST /api/v1/recipie/ocr/gemini
GEMINI_API_KEY=
GEMINI_RECEIPT_MODEL=gemini-2.5-flash-lite
